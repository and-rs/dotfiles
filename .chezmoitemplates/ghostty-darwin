font-size = 18
# start nushell from nix
command = /run/current-system/sw/bin/nu
config-file = fonts.ghostty

fullscreen = false
window-padding-y = 0
window-padding-x = 0
window-decoration = false
macos-option-as-alt = true
auto-update-channel = stable
macos-window-buttons = hidden
macos-titlebar-style = hidden
confirm-close-surface = false
macos-non-native-fullscreen = true
quit-after-last-window-closed = true

# ->theme
config-file = themes/current

# ->only for darkmode
custom-shader-animation = false
#custom-shader = shaders/crt.glsl
#custom-shader = shaders/dot_matrix.glsl
#custom-shader = shaders/glow.glsl

window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

adjust-icon-height = 8
adjust-cell-height = 6
adjust-cursor-height = 0
adjust-cursor-thickness = 3
cursor-style-blink = false

#--- KEYBINDS ---#
keybind = clear

keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

keybind = super+shift+,=reload_config
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard:mixed

keybind = opt+ctrl+f=text:\x1bf
keybind = opt+ctrl+b=text:\x1bb

keybind = super+m=text:\x1bm
keybind = super+ctrl+u=text:\x1b\x15
keybind = super+ctrl+d=text:\x1b\x04
