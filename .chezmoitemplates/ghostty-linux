font-size = 13
# () 	 very importnat check
minimum-contrast = 1.1
command = nu
config-file = fonts.ghostty
config-file = themes/current
async-backend = io_uring

#--- WINDOW ---#
quit-after-last-window-closed = true
window-padding-balance = true
confirm-close-surface = false
adjust-cursor-thickness = 2
adjust-icon-height = 8
window-decoration = none
window-padding-x = 1
window-padding-y = 0
faint-opacity = 1.0
# background-opacity = 0.7

cursor-style = block
cursor-style-blink = false
cursor-opacity = 0
shell-integration-features = no-cursor

# Enabling this increases CPU usage
custom-shader-animation = true
custom-shader = shaders/cursor_wire.glsl
# custom-shader = shaders/cursor_ripple.glsl
# custom-shader = shaders/cursor_slash.glsl
# custom-shader = shaders/fire.glsl

#--- KEYBINDS ---#
keybind = clear
keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

keybind = super+ctrl+f=text:\x1bf
keybind = super+ctrl+b=text:\x1bb

keybind = super+backspace=text:\x17
keybind = alt+backspace=text:\x15

keybind = super+h=text:\x1bh
keybind = super+j=text:\x1bj
keybind = super+k=text:\x1bk
keybind = super+l=text:\x1bl

keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard
keybind = alt+shift+,=reload_config
