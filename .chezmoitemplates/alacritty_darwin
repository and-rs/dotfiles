[general]
import = [ "~/.config/alacritty/themes/current.toml" ]

[env]
TERM = "alacritty"

[terminal]
shell = "/run/current-system/sw/bin/nu"

[cursor]
style = { blinking = "Never" }
thickness = 0.3

[font]
size = 19

normal = { family = "Rec Mono Linear" }
bold = { family = "Rec Mono Linear" }
italic = { family = "Rec Mono Casual" }
bold_italic = { family = "Rec Mono Casual" }

[window]
title = "Terminalino"
dynamic_padding = true
decorations = "Buttonless"
option_as_alt = "Both"

[window.padding]
x = 8
y = 0

[keyboard]
bindings = [
#   { key = "V", mods = "Alt", action = "Paste" },
#   { key = "C", mods = "Alt", action = "Copy" },
#
  { key = "F", mods = "Option|Control", chars = "\u001bf" },
  { key = "B", mods = "Option|Control", chars = "\u001bb" },
  { key = "Enter", mods = "Shift", chars = "\x1b[13;2u" },
