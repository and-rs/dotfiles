{{- $max := maxf .r .g .b -}}
{{- $min := minf .r .g .b -}}
{{- $lightness := divf (addf $max $min) 2.0 -}}
{{- $hue := 0.0 -}}
{{- $saturation := 0.0 -}}
{{- if ne $max $min -}}
  {{- $delta := subf $max $min -}}
  {{- if gt $lightness 0.5 -}}
    {{- $saturation = divf $delta (subf 2.0 (addf $max $min)) -}}
  {{- else -}}
    {{- $saturation = divf $delta (addf $max $min) -}}
  {{- end -}}
  {{- if eq $max .r -}}
    {{- $hue = divf (addf (divf (subf .g .b) $delta) (ternary 1.0 0.0 (lt .g .b))) 6.0 -}}
  {{- else if eq $max .g -}}
    {{- $hue = divf (addf (divf (subf .b .r) $delta) 2.0) 6.0 -}}
  {{- else -}}
    {{- $hue = divf (addf (divf (subf .r .g) $delta) 4.0) 6.0 -}}
  {{- end -}}
{{- end -}}
{{- $_ := set .out "h" $hue -}}
{{- $_ := set .out "s" $saturation -}}
{{- $_ := set .out "l" $lightness -}}
