{{- $t := .t -}}
{{- if lt $t 0.0 }}{{ $t = addf $t 1.0 }}{{ end -}}
{{- if gt $t 1.0 }}{{ $t = subf $t 1.0 }}{{ end -}}
{{- $p := .p -}}
{{- $q := .q -}}
{{- $value := 0.0 -}}
{{- if lt $t (divf 1.0 6.0) -}}
  {{- $value = addf $p (mulf (subf $q $p) (mulf 6.0 $t)) -}}
{{- else if lt $t 0.5 -}}
  {{- $value = $q -}}
{{- else if lt $t (divf 2.0 3.0) -}}
  {{- $value = addf $p (mulf (subf $q $p) (mulf 6.0 (subf (divf 2.0 3.0) $t))) -}}
{{- else -}}
  {{- $value = $p -}}
{{- end -}}
{{- $_ := set .out "value" $value -}}
