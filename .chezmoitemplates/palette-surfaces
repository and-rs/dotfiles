{{- $bg := hexDecode (trimPrefix "#" .bg) -}}
{{- $r := divf (float64 (index $bg 0)) 255.0 -}}
{{- $g := divf (float64 (index $bg 1)) 255.0 -}}
{{- $b := divf (float64 (index $bg 2)) 255.0 -}}
{{- $hsl := dict "h" 0.0 "s" 0.0 "l" 0.0 -}}
{{- template "rgb-to-hsl" (dict "r" $r "g" $g "b" $b "out" $hsl) -}}
{{- $accent := hexDecode (trimPrefix "#" .blue) -}}
{{- $accentR := divf (float64 (index $accent 0)) 255.0 -}}
{{- $accentG := divf (float64 (index $accent 1)) 255.0 -}}
{{- $accentB := divf (float64 (index $accent 2)) 255.0 -}}
{{- $accentHsl := dict "h" 0.0 "s" 0.0 "l" 0.0 -}}
{{- template "rgb-to-hsl" (dict "r" $accentR "g" $accentG "b" $accentB "out" $accentHsl) -}}
{{- $surfaces := list (list "surface1" 0.03) (list "surface2" 0.07) (list "surface3" 0.16) (list "surface4" 0.26) (list "surface5" 0.36) -}}
{{- $light := false -}}
{{- if gt (addf (mulf $r 0.2126) (mulf $g 0.7152) (mulf $b 0.0722)) 0.5 -}}
  {{- $light = true -}}
{{- end -}}
{{- range $surface := $surfaces -}}
  {{- $name := index $surface 0 -}}
  {{- $amount := index $surface 1 -}}
  {{- $l := index $hsl "l" -}}
  {{- if $light }}{{ $l = maxf 0.0 (subf $l $amount) }}{{ else }}{{ $l = minf 1.0 (addf $l $amount) }}{{ end -}}
  {{- $h := index $hsl "h" -}}
  {{- $s := index $hsl "s" -}}
  {{- if gt $s 0.01 -}}
    {{- $hueDistance := subf (index $accentHsl "h") $h -}}
    {{- if gt $hueDistance 0.5 }}{{ $hueDistance = subf $hueDistance 1.0 }}{{ end -}}
    {{- if lt $hueDistance -0.5 }}{{ $hueDistance = addf $hueDistance 1.0 }}{{ end -}}
    {{- $tint := minf 0.35 (addf 0.08 (mulf $amount 0.5)) -}}
    {{- $h = addf $h (mulf $hueDistance $tint) -}}
    {{- $s = minf 1.0 (addf $s (mulf (subf (index $accentHsl "s") $s) $tint)) -}}
  {{- end -}}
  {{- $q := 0.0 -}}
  {{- if lt $l 0.5 }}{{ $q = mulf $l (addf 1.0 $s) }}{{ else }}{{ $q = subf (addf $l $s) (mulf $l $s) }}{{ end -}}
  {{- $p := subf (mulf 2.0 $l) $q -}}
  {{- $red := dict "value" 0.0 -}}
  {{- $green := dict "value" 0.0 -}}
  {{- $blue := dict "value" 0.0 -}}
  {{- template "hsl-channel" (dict "p" $p "q" $q "t" (addf $h (divf 1.0 3.0)) "out" $red) -}}
  {{- template "hsl-channel" (dict "p" $p "q" $q "t" $h "out" $green) -}}
  {{- template "hsl-channel" (dict "p" $p "q" $q "t" (subf $h (divf 1.0 3.0)) "out" $blue) -}}
  {{- $_ := set $ (toString $name) (printf "#%02x%02x%02x" (int (round (mulf (index $red "value") 255.0) 0)) (int (round (mulf (index $green "value") 255.0) 0)) (int (round (mulf (index $blue "value") 255.0) 0))) -}}
{{- end -}}
