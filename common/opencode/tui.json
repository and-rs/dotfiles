{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight-day",
  "keybinds": {
    "app_exit": "none",
    "terminal_suspend": "none",
    "command_list": "alt+p",

    "messages_half_page_up": "ctrl+alt+u",
    "messages_half_page_down": "ctrl+alt+d",
    "messages_first": "none",
    "messages_last_user": "ctrl+g",

    "editor_open": "ctrl+o",
    "input_move_up": "ctrl+p",
    "input_move_down": "ctrl+n",
    "input_undo": "ctrl+z",
    "input_redo": "ctrl+shift+z"
  }
}
