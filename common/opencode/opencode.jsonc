{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": { "*": "allow", "**/.env": "deny", "**/.env.*": "deny" },
    "glob": { "*": "allow", "**/.env": "deny", "**/.env.*": "deny" },
    "grep": { "*": "allow", "**/.env": "deny", "**/.env.*": "deny" },
    "bash": { "*": "ask" }
  }
}
