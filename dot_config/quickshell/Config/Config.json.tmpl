    "fg": "{{ $c.fg }}",
    "bg": "{{ $c.bg }}",
    "primary": "{{ $c.blue }}",
    "success": "{{ $c.green }}",
    "destructive": "{{ $c.red }}",
    "secondary": "{{ $c.magenta }}",
    "surface1": "{{ $c.surface1 }}",
    "surface2": "{{ $c.surface2 }}",
    "surface3": "{{ $c.surface3 }}",
