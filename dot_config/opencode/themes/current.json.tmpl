{{- $c := index .palettes .theme -}}
{{- $paletteScript := joinPath .chezmoi.sourceDir "dot_config/nushell/utils/palette.nu" -}}
{{- range $name, $value := (output "nu" $paletteScript "surfaces" $c.bg $c.blue | fromJson) -}}
  {{- $_ := set $c $name $value -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "{{ $c.bg }}",
    "fg": "{{ $c.fg }}",
    "blue": "{{ $c.blue }}",
    "magenta": "{{ $c.magenta }}",
    "red": "{{ $c.red }}",
    "green": "{{ $c.green }}",
    "yellow": "{{ $c.yellow }}",
    "cyan": "{{ $c.cyan }}",
    "surface1": "{{ $c.surface1 }}",
    "surface2": "{{ $c.surface2 }}",
    "surface3": "{{ $c.surface3 }}",
    "surface4": "{{ $c.surface4 }}",
    "surface5": "{{ $c.surface5 }}"
  },
  "theme": {
    "primary": "blue",
    "secondary": "magenta",
    "accent": "yellow",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue",
    "text": "fg",
    "textMuted": "surface5",

    "background": "bg",
    "backgroundPanel": "surface1",
    "backgroundElement": "surface1",

    "border": "surface3",
    "borderActive": "surface4",
    "borderSubtle": "surface3",

    "diffAdded": "green",
    "diffRemoved": "red",
    "diffContext": "surface5",
    "diffHunkHeader": "surface5",
    "diffHighlightAdded": "green",
    "diffHighlightRemoved": "red",
    "diffAddedBg": "surface1",
    "diffRemovedBg": "surface1",
    "diffContextBg": "surface1",
    "diffLineNumber": "surface4",
    "diffAddedLineNumberBg": "surface1",
    "diffRemovedLineNumberBg": "surface1",

    "markdownText": "fg",
    "markdownHeading": "magenta",
    "markdownLink": "blue",
    "markdownLinkText": "cyan",
    "markdownCode": "green",
    "markdownBlockQuote": "yellow",
    "markdownEmph": "yellow",
    "markdownStrong": "yellow",
    "markdownHorizontalRule": "surface5",
    "markdownListItem": "blue",
    "markdownListEnumeration": "cyan",
    "markdownImage": "blue",
    "markdownImageText": "cyan",
    "markdownCodeBlock": "fg",

    "syntaxComment": "surface3",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "red",
    "syntaxString": "green",
    "syntaxNumber": "yellow",
    "syntaxType": "yellow",
    "syntaxOperator": "cyan",
    "syntaxPunctuation": "fg"
  }
}
