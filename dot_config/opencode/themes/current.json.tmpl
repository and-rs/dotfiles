{{- $c := index .palettes .theme -}}
{{- $paletteScript := joinPath .chezmoi.sourceDir "dot_config/nushell/utils/palette.nu" -}}
{{- range $name, $value := (output "nu" $paletteScript "surfaces" $c.bg $c.blue | fromJson) -}}
  {{- $_ := set $c $name $value -}}
{{- end -}}
{{- range $name, $value := (output "nu" $paletteScript "diff-backgrounds" $c.bg $c.red $c.green | fromJson) -}}
  {{- $_ := set $c $name $value -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/theme.json",
  "dark": {
    "hue": {
      "blue": {{ output "nu" $paletteScript "hue-scale" $c.blue $c.bg }},
      "purple": {{ output "nu" $paletteScript "hue-scale" $c.magenta $c.bg }},
      "neutral": "$hue.blue",
      "accent": "$hue.purple",
      "interactive": "$hue.blue"
    }
  },
  "base": {
    "categorical": ["blue", "purple"],
    "text": {
      "base": "{{ $c.fg }}",
      "muted": "{{ $c.surface5 }}",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$background.base",
          "$selected": "$hue.interactive.200"
        },
        "secondary": { "base": "$text.muted", "$hovered": "$text.base" },
        "destructive": { "base": "$background.base", "$disabled": "$text.muted" }
      },
      "formfield": {
        "base": "{{ $c.surface5 }}",
        "$pressed": "$hue.interactive.200",
        "$hovered": "$hue.interactive.100",
        "$focused": "$hue.interactive.100",
        "$selected": "$hue.interactive.100",
        "$disabled": "$text.muted"
      },
      "feedback": {
        "error": { "base": "{{ $c.red }}" },
        "warning": { "base": "{{ $c.yellow }}" },
        "success": { "base": "{{ $c.cyan }}" },
        "info": { "base": "{{ $c.blue }}" }
      }
    },
    "background": {
      "base": "{{ $c.bg }}",
      "raised": {
        "base": "{{ $c.surface0 }}",
        "high": "{{ $c.surface1 }}",
        "max": "{{ $c.surface5 }}"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "{{ $c.red }}" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "{{ $c.surface3 }}" },
    "scrollbar": { "base": "{{ $c.surface4 }}" },
    "diff": {
      "text": {
        "added": "{{ $c.green }}",
        "removed": "{{ $c.red }}",
        "context": "{{ $c.surface5 }}",
        "hunkHeader": "{{ $c.surface5 }}"
      },
      "background": {
        "added": "{{ $c.diff_green_bg }}",
        "removed": "{{ $c.diff_red_bg }}",
        "context": "{{ $c.surface1 }}"
      },
      "highlight": { "added": "{{ $c.green }}", "removed": "{{ $c.red }}" },
      "lineNumber": {
        "text": "{{ $c.surface5 }}",
        "background": { "added": "{{ $c.diff_green_bg }}", "removed": "{{ $c.diff_red_bg }}" }
      }
    },
    "markdown": {
      "text": "{{ $c.fg }}",
      "heading": "{{ $c.magenta }}",
      "link": "{{ $c.blue }}",
      "linkText": "{{ $c.cyan }}",
      "code": "{{ $c.green }}",
      "blockQuote": "{{ $c.yellow }}",
      "emphasis": "{{ $c.yellow }}",
      "strong": "{{ $c.yellow }}",
      "horizontalRule": "{{ $c.surface5 }}",
      "listItem": "{{ $c.blue }}",
      "listEnumeration": "{{ $c.cyan }}",
      "image": "{{ $c.blue }}",
      "imageText": "{{ $c.cyan }}",
      "codeBlock": "{{ $c.fg }}"
    },
    "syntax": {
      "comment": "{{ $c.surface3 }}",
      "keyword": "{{ $c.magenta }}",
      "function": "{{ $c.blue }}",
      "variable": "{{ $c.red }}",
      "string": "{{ $c.green }}",
      "number": "{{ $c.yellow }}",
      "type": "{{ $c.yellow }}",
      "operator": "{{ $c.cyan }}",
      "punctuation": "{{ $c.fg }}"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": { "primary": { "$hovered": "$background.raised.high" } }
      }
    }
  }
}
