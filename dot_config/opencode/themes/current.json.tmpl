{{- $c := index .palettes .theme -}}
{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "base": "{{ $c.base }}",
    "fg": "{{ $c.fg }}",
    "blue": "{{ $c.blue }}",
    "magenta": "{{ $c.magenta }}",
    "red": "{{ $c.red }}",
    "green": "{{ $c.green }}",
    "yellow": "{{ $c.yellow }}",
    "cyan": "{{ $c.cyan }}",
    "surface1": "{{ $c.surface1 }}",
    "surface2": "{{ $c.surface2 }}",
    "surface3": "{{ $c.surface3 }}",
    "surface4": "{{ $c.surface4 }}",
    "surface5": "{{ $c.surface5 }}"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "magenta", "light": "magenta" },
    "accent": { "dark": "yellow", "light": "yellow" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "surface5", "light": "surface5" },
    "background": { "dark": "base", "light": "base" },
    "backgroundPanel": { "dark": "surface1", "light": "surface1" },
    "backgroundElement": { "dark": "surface2", "light": "surface2" },
    "border": { "dark": "surface3", "light": "surface3" },
    "borderActive": { "dark": "surface4", "light": "surface4" },
    "borderSubtle": { "dark": "surface3", "light": "surface3" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "surface5", "light": "surface5" },
    "diffHunkHeader": { "dark": "surface5", "light": "surface5" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "surface1", "light": "surface1" },
    "diffRemovedBg": { "dark": "surface1", "light": "surface1" },
    "diffContextBg": { "dark": "surface1", "light": "surface1" },
    "diffLineNumber": { "dark": "surface4", "light": "surface4" },
    "diffAddedLineNumberBg": { "dark": "surface1", "light": "surface1" },
    "diffRemovedLineNumberBg": { "dark": "surface1", "light": "surface1" },
    "markdownText": { "dark": "fg", "light": "fg" },
    "markdownHeading": { "dark": "magenta", "light": "magenta" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "cyan", "light": "cyan" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "yellow", "light": "yellow" },
    "markdownEmph": { "dark": "yellow", "light": "yellow" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "surface5", "light": "surface5" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "cyan", "light": "cyan" },
    "markdownCodeBlock": { "dark": "fg", "light": "fg" },
    "syntaxComment": { "dark": "surface5", "light": "surface5" },
    "syntaxKeyword": { "dark": "magenta", "light": "magenta" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "red", "light": "red" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "yellow", "light": "yellow" },
    "syntaxType": { "dark": "yellow", "light": "yellow" },
    "syntaxOperator": { "dark": "cyan", "light": "cyan" },
    "syntaxPunctuation": { "dark": "fg", "light": "fg" }
  }
}
