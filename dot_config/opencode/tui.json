{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "current",
  "keybinds": {
    "app_exit": "none",
    "terminal_suspend": "none",
    "command_list": "alt+p",

    "messages_half_page_up": "ctrl+alt+u",
    "messages_half_page_down": "ctrl+alt+d",
    "messages_first": "none",
    "messages_last_user": "ctrl+g",
    "messages_last": "ctrl+alt+g,end",

    "editor_open": "ctrl+o",
    "input_move_up": "ctrl+p",
    "input_move_down": "ctrl+n",
    "history_previous": "ctrl+n",
    "history_next": "ctrl+p",
    "input_undo": "ctrl+z,ctrl+-",
    "input_redo": "ctrl+shift+z,ctrl+."
  }
}
