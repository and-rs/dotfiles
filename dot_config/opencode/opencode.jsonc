{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "glob": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "grep": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "git commit": "deny",
      "git commit *": "deny",
      "gh": "deny",
      "gh *": "deny"
    }
  }
}
