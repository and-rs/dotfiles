configuration {
    location: 0;
    show-icons: false;
    terminal: "ghostty";

    kb-element-next: "";
    kb-element-prev: "";
    kb-mode-previous: "Control+h,ISO_Left_Tab";
    kb-mode-next: "Control+l,Tab";
    kb-row-down: "Down,Control+n,Control+j";
    kb-row-up: "Up,Control+p,Control+k";
    kb-remove-char-back: "BackSpace,Shift+BackSpace";
    kb-mode-complete: "";
    kb-remove-to-eol: "";
    kb-accept-entry: "Control+m,Return,KP_Enter";

    drun-display-format: "{name}";
    display-calc: "Calc";
    display-drun: "Apps";
    display-desktop: "Desktop";
    display-run: "Command";
    display-window: "Windows";
    sidebar-mode: true;
}

@theme "./monochrome.rasi"
