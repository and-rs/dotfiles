{{- $c := index .palettes .theme -}}
{{- $paletteScript := joinPath .chezmoi.sourceDir "dot_config/nushell/utils/palette.nu" -}}
{{- range $name, $value := (output "nu" $paletteScript "surfaces" $c.bg $c.blue | fromJson) -}}
  {{- $_ := set $c $name $value -}}
{{- end -}}
* {
    font: "SF Pro 11";
    width: 700px;
    height: 376px;
}

error-message {
    background-color: {{ $c.surface1 }};
    padding: 10px;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

window {
    border: 2px;
    border-radius: {{ mul .radii.unit .radii.multiplier .radii.compact }}px;
    border-color: {{ $c.surface5 }};
}

mainbox {
    background-color: {{ $c.surface1 }};
}

inputbar {
    children: [prompt,entry];
    background-color: transparent;
    border-radius: {{ mul .radii.unit .radii.multiplier .radii.compact }}px;
    padding: 1px;
}

prompt {
    background-color: {{ $c.fg }};
    text-color: {{ $c.bg }};
    padding: 6px;
    border-radius: {{ mul .radii.unit .radii.multiplier .radii.compact }}px;
    margin: 10px 0px 0px 10px;
}

entry {
    padding: 6px 6px 6px 0px;
    margin: 10px 0px 0px 10px;
    text-color: {{ $c.fg }};
    background-color: transparent;
}

listview {
    lines: 10;
    columns: 1;
    margin: 10px 10px 9px 10px ;
    border: 0px 0px 1px 0px;
    border-color: {{ $c.surface2 }};
    background-color: transparent;
}

element {
    padding: 6px;
    background-color: transparent;
    text-color: {{ $c.fg }};
}

element selected {
    border-radius: {{ mul .radii.unit .radii.multiplier .radii.compact }}px;
    background-color:  {{ $c.fg }};
    text-color: {{ $c.bg }};
}

/* Niri uses active as a styling marker for disabled rows. */
element selected.active {
    background-color: {{ $c.surface3 }};
    text-color: {{ $c.fg }};
}

mode-switcher {
    background-color: transparent;
}

button {
    padding: 6px;
    margin: 0px 10px 10px 10px;

    background-color: transparent;
    text-color: {{ $c.fg }};

    border-radius: {{ mul .radii.unit .radii.multiplier .radii.small }}px;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: {{ $c.fg }};
    text-color: {{ $c.bg }};
}

message {
    background-color: transparent;
    margin: 10px 10px 0 10px;
    padding: 6px;
    border: 1px;
    border-radius: {{ mul .radii.unit .radii.multiplier .radii.small }}px;
    border-color: {{ $c.surface3 }};
}

textbox {
    text-color: {{ $c.fg }};
    background-color: transparent;
}
