#!/usr/bin/env -S nu -n

def main [] {
  $env.TMUX_PICKER_CLIENT = (tmux display-message -p "#{client_name}")

  let preview_cmd = '
        let preview_width = ($env.FZF_PREVIEW_COLUMNS | into int)
        let column_width = (($preview_width - 4) / 3 | math floor | into int)
        let fit = {|value|
          let value = ($value | ansi strip)
          let length = ($value | str length --grapheme-clusters)
          let clipped = if $length > $column_width {
            $"…($value | str substring --grapheme-clusters ($length - $column_width + 1)..)"
          } else { $value }
          $clipped | fill --width $column_width
        }
        tmux list-windows -t {1} -F "#{window_name}\t#{pane_current_command}\t#{pane_current_path}"
        | from tsv --noheaders
        | rename name process dir
        | upsert name {|row| do $fit $row.name }
        | upsert process {|row| do $fit $row.process }
        | upsert dir {|row| do $fit ($row.dir | str replace $env.HOME "~") }
        | to tsv
        | qsv table --delimiter "\t" --pad 2
        | str replace --all "~" $"(ansi blue)~(ansi reset)"
        | lines
        | upsert 0 {|row| $"(ansi magenta)($row)(ansi reset)"}
        | insert 1 ("" | fill --character $"(ansi black)─(ansi reset)" --width $preview_width)
        | str join (char newline)
        '

  let list_sessions = '
        tmux list-sessions -F "#{session_name}\t#{window_name}\t#{session_attached_list}\t#{session_last_attached}"
        | from tsv --noheaders
        | rename session window attached last_attached
        | into int last_attached
        | sort-by last_attached --reverse
        | reject last_attached
        | to tsv
        | qsv table --delimiter "\t" --align leftendtab --pad 1
        '

  let kill_cmd = '
        let session = {1}
        let current = (tmux display-message -p -c $env.TMUX_PICKER_CLIENT "#{client_session}" | complete)
        if $current.exit_code != 0 { exit 0 }

        if $session == ($current.stdout | str trim) {
          let alternatives = (tmux list-sessions -F "#{session_name}" | lines | where {|name| $name != $session })
          if ($alternatives | is-empty) { exit 0 }
          let switched = (tmux switch-client -c $env.TMUX_PICKER_CLIENT -t $"=($alternatives.0)" | complete)
          if $switched.exit_code != 0 { exit 0 }
        }

        tmux kill-session -t $"=($session)"
        '

  let create_cmd = '
        let sessions = (tmux list-sessions -F "#{session_name}" | lines)
        for session in [alpha beta delta gamma] {
          if $session not-in $sessions {
            tmux new-session -d -s $session -c $env.PWD
            break
          }
        }
        '

  let kill_bind = "ctrl-k:execute-silent(" + $kill_cmd + ")+reload(" + $list_sessions + ")"
  let create_bind = "ctrl-s:execute-silent(" + $create_cmd + ")+reload(" + $list_sessions + ")"

  let separator = $"(ansi black)│(ansi reset)"
  let selection = (
    nu -c $list_sessions
    | fzf
    -d '\t'
    --nth=2
    --ansi
    --cycle
    --reverse
    --no-sort
    --prompt=' μ '
    --accept-nth=1
    --header-lines=1
    --footer-border='top'
    --footer='<enter: switch>  <ctrl-k: kill>  <ctrl-s: create>  <esc: cancel>'
    --with-nth $"{1}\t($separator) {2}\t($separator) {3}"
    --bind $kill_bind
    --bind $create_bind
    --preview $preview_cmd
    --preview-window='bottom,50%'
    | complete
  )

  if $selection.exit_code != 0 { exit 0 }

  let session = ($selection.stdout | str trim)
  if ($session | is-empty) { exit 0 }

  tmux switch-client -c $env.TMUX_PICKER_CLIENT -t $"=($session)"
}
