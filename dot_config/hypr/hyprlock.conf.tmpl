{{- $queryScript := joinPath .chezmoi.sourceDir "dot_config/hypr/executable_awww-query.sh" -}}
{{- $wallpaper := output "bash" $queryScript | trim -}}
{{- $c := index .palettes .theme -}}
$font = SF Pro
$font_clock = SF Pro:style=Expanded Semibold
$shadow_passes = 1
$shadow_size = 1
$shadow_color = rgba(000000aa)
$shadow_boost = 1.4

general {
    hide_cursor = true
}

# Keep authentication feedback immediate and unambiguous.
animations {
    enabled = true
    animation = fadeIn, 1, 5, linear
}

# Render current awww wallpaper, or a neutral lock surface when unavailable.
background {
    monitor =
{{- if $wallpaper }}
    path = {{ $wallpaper }}
{{- else }}
    color = rgba(000000ff)
{{- end }}
    blur_passes = 2
    blur_size = 8
}

# The interactive surface lives only on the built-in display.
input-field {
    monitor = $main_monitor
    size = 280, 52
    outline_thickness = 2
    inner_color = rgba({{ trimPrefix "#" $c.bg }}e6)
    outer_color = rgba({{ trimPrefix "#" $c.blue }}ff)
    check_color = rgba({{ trimPrefix "#" $c.green }}ff)
    fail_color = rgba({{ trimPrefix "#" $c.red }}ff)
    font_color = rgba({{ trimPrefix "#" $c.fg }}ff)
    font_family = $font
    shadow_passes = $shadow_passes
    shadow_size = $shadow_size
    shadow_color = $shadow_color
    shadow_boost = $shadow_boost
    rounding = -1
    fade_on_empty = false
    placeholder_text = Enter Password
    check_text = Authenticating...
    fail_text = Incorrect password
    dots_size = 0.28
    dots_spacing = 0.25
    position = 0, -380
    halign = center
    valign = center
}

# big clock
label {
    monitor = $main_monitor
    text = $TIME
    color = rgba(f5f5f7ff)
    font_size = 124
    font_family = $font_clock
    shadow_passes = $shadow_passes
    shadow_size = $shadow_size
    shadow_color = $shadow_color
    shadow_boost = $shadow_boost
    position = 0, 280
    halign = center
    valign = center
}

# current date
label {
    monitor = $main_monitor
    text = cmd[update:60000] date +"%A, %B %-d"
    color = rgba(ebebf0ff)
    font_size = 26
    font_family = $font
    shadow_passes = $shadow_passes
    shadow_size = $shadow_size
    shadow_color = $shadow_color
    shadow_boost = $shadow_boost
    position = 0, 375
    halign = center
    valign = center
}
