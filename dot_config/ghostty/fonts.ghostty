# ▣ I hate this little opencode square so much.
font-codepoint-map = U+25A3=CommitMono

#adjust-font-baseline = 0
#adjust-underline-thickness = 1
#adjust-underline-position = 2

# font-family = OCR-X TTF
# font-feature = +ss02
# font-feature = +ss04
# font-feature = +ss03
# font-style-bold = Regular
# font-style-italic = Regular
# font-style-bold-italic = Regular
adjust-underline-thickness = 1
adjust-underline-position = 4
adjust-strikethrough-thickness = 1
adjust-strikethrough-position = -6
adjust-cell-height = 6
adjust-box-thickness = 1
adjust-cursor-height = 6
# # emdash
# font-codepoint-map = U+2014=CommitMono


# Α Β Γ Δ Ε Ζ Η Θ Ι Κ Λ Μ Ν Ξ Ο Π Ρ Σ Τ Υ Φ Χ Ψ Ω
