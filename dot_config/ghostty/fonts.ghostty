### VALUES ###
adjust-font-baseline = 1
adjust-box-thickness = 1
adjust-underline-thickness = 1
adjust-strikethrough-thickness = 1

# () should be half of the cursor height
adjust-underline-position = 4 
adjust-strikethrough-position = -4
adjust-cursor-height = 8
adjust-cell-height = 6

### OVERRIDES ###
# Α Β Γ Δ Ε Ζ Η Θ Ι Κ Λ Μ Ν Ξ Ο Π Ρ Σ Τ Υ Φ Χ Ψ Ω
#font-codepoint-map = U+0391-U+03A9=Input
# α β γ δ ε ζ η θ ι κ λ μ ν ξ ο π ρ σ τ υ φ χ ψ ω ς
#font-codepoint-map = U+03B1-U+03C9,U+03C2=Input
# ✱ ▣ I hate these little opencode fuckers so much.
font-codepoint-map = U+25A3=Monaspace Krypton
font-codepoint-map = U+2731=Monaspace Krypton

### FONTS ###
#font-family = JetBrains Mono
#font-family = Maple Mono
#font-family = CommitMono
font-family = Fragment Mono

