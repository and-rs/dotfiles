{
  "name": "pi-local-agent",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": ["./src/app/index.ts"],
    "skills": ["../skills"],
    "themes": ["../themes"]
  },
  "scripts": {
    "fmt": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
