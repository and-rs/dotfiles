    "check": "biome ci . && tsc -p tsconfig.json --noEmit && knip && bun test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.1.1",
    "knip": "^6.37.0",
    "typescript": "^7.0.2"
  }
}
