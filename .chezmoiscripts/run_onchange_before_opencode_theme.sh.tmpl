#!/bin/sh
set -eu

themes={{ joinPath .chezmoi.homeDir ".config/opencode/themes" | shellQuote }}
mkdir -p "$themes"
{{ range $name, $palette := .palettes }}
theme={{ printf "%s.json" ($name | replace "-" "_") | shellQuote }}
cat > "$themes/$theme.tmp" <<'OPENCODE_THEME'
{{ includeTemplate "opencode_theme" (dict "palette" $palette "chezmoi" $.chezmoi) }}
OPENCODE_THEME
mv "$themes/$theme.tmp" "$themes/$theme"
{{ end }}

# Remove only filenames generated by this setup, preserving unrelated themes.
for old in current.json{{ range $name, $_ := .palettes }}{{ if ne $name ($name | replace "-" "_") }} {{ printf "%s.json" $name | shellQuote }}{{ end }}{{ end }}; do
    rm -f "$themes/$old"
done
