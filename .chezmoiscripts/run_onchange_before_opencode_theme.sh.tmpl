#!/bin/sh
set -eu

themes={{ joinPath .chezmoi.homeDir ".config/opencode/themes" | shellQuote }}
theme={{ printf "%s.json" (.theme | replace "-" "_") | shellQuote }}
mkdir -p "$themes"
cat > "$themes/$theme.tmp" <<'OPENCODE_THEME'
{{ includeTemplate "opencode_theme" (dict "palette" (index .palettes .theme) "chezmoi" .chezmoi) }}
OPENCODE_THEME
mv "$themes/$theme.tmp" "$themes/$theme"

# Remove only filenames generated by this setup, preserving unrelated themes.
for old in current.json{{ range $name, $_ := .palettes }} {{ printf "%s.json" $name | shellQuote }} {{ printf "%s.json" ($name | replace "-" "_") | shellQuote }}{{ end }}; do
    if [ "$old" != "$theme" ]; then
        rm -f "$themes/$old"
    fi
done
